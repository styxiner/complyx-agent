# Maintainer: Complyx Team <dev@complyx.io>
pkgname=complyx-agent
pkgver=0.1.0
pkgrel=1
pkgdesc="Complyx Security and Compliance Agent"
arch=('x86_64' 'aarch64')
url="https://github.com/styxiner/complyx-agent"
license=('custom:Proprietary')

# Dependencias en runtime: el binario Rust es estático, no necesita nada
depends=('systemd')

# El binario ya compilado se pasa como source
# En CI se compila con: cargo build --release --target x86_64-unknown-linux-musl
source=(
  "complyx-agent::file://complyx-agent"
  "agent.toml::file://agent.toml"
  "complyx-agent.service::file://complyx-agent.service"
)
noextract=('complyx-agent')

# No calculamos sha256 aquí porque el binario se genera en CI
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
  # Binario
  install -D -m 0755 "$srcdir/complyx-agent" \
    "$pkgdir/usr/bin/complyx-agent"

  # Configuración (noreplace: pacman no sobreescribe si ya existe)
  install -D -m 0644 "$srcdir/agent.toml" \
    "$pkgdir/etc/complyx/agent.toml"

  # Unidad systemd
  install -D -m 0644 "$srcdir/complyx-agent.service" \
    "$pkgdir/usr/lib/systemd/system/complyx-agent.service"
}

post_install() {
  # Crear grupo y usuario del sistema
  getent group complyx >/dev/null || groupadd --system complyx
  getent passwd complyx >/dev/null ||
    useradd --system --gid complyx \
      --home-dir /var/lib/complyx \
      --no-create-home \
      --shell /sbin/nologin \
      complyx

  # Directorios de datos
  install -d -m 0755 -o complyx -g complyx /var/lib/complyx
  install -d -m 0700 -o complyx -g complyx /var/lib/complyx/certs

  systemctl daemon-reload

  echo ""
  echo "=== Complyx Agent instalado ==="
  echo "Configura el servidor en /etc/complyx/agent.toml"
  echo "Luego: COMPLYX_ENROLL_TOKEN=<token> systemctl start complyx-agent"
  echo ""
}

post_upgrade() {
  systemctl daemon-reload
  systemctl try-restart complyx-agent.service || true
}

pre_remove() {
  systemctl stop complyx-agent.service || true
  systemctl disable complyx-agent.service || true
}

post_remove() {
  systemctl daemon-reload

  # Limpiar datos y usuario
  rm -rf /var/lib/complyx /etc/complyx
  getent passwd complyx >/dev/null && userdel complyx || true
  getent group complyx >/dev/null && groupdel complyx || true
}
