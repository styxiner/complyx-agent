[Unit]
Description=Complyx Security Agent
Documentation=https://github.com/styxiner/complyx-agent
After=network-online.target
Wants=network-online.target
# Reintentar si el servidor no está disponible en el arranque
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=complyx
Group=complyx

# Binario y configuración
ExecStart=/usr/bin/complyx-agent
Environment=COMPLYX_CONFIG_PATH=/etc/complyx/agent.toml

# Reinicio automático ante fallos (no ante parada limpia)
Restart=on-failure
RestartSec=30s

# Directorio de trabajo (no usa el home del usuario)
WorkingDirectory=/var/lib/complyx

# Logging: journald captura stdout/stderr directamente
StandardOutput=journal
StandardError=journal
SyslogIdentifier=complyx-agent

# ===========================================================================
# Hardening del servicio systemd
# ===========================================================================
# Que se podría endurecer mucho más? Pues seguramente, pero no puedo perder mucho tiempo en esto.
# Para siguientes versiones incluiré también perfiles de selinux y apparmor

# El servicio necesita leer /etc para los checks y escribir /var/lib/complyx
# No necesita acceso a la red excepto para el gRPC

# Sin nuevos privilegios (evita escalada vía setuid/setgid)
NoNewPrivileges=yes

# Sistema de ficheros protegido
ProtectSystem=strict
# Excepciones de escritura explícitas:
ReadWritePaths=/var/lib/complyx /etc/sysctl.d
# Los checks leen /etc, /proc, /run — solo lectura
ReadOnlyPaths=/etc /proc/sys /run/

# Home del usuario no accesible
ProtectHome=yes

# /tmp privado para este servicio
PrivateTmp=yes

# Sin acceso a /dev (el agente no necesita dispositivos)
PrivateDevices=yes

# Namespaces de red: NO privado porque necesita conectarse al servidor gRPC
# PrivateNetwork=no  (defecto)

# Filtro de llamadas al sistema (syscall allowlist)
SystemCallFilter=@system-service @file-system @network-io
SystemCallFilter=~@privileged @obsolete @debug @reboot @swap @raw-io

# Capabilities necesarias para:
# - CAP_NET_ADMIN: modificar parámetros de red via sysctl
# - CAP_SYS_PTRACE: leer /proc de otros procesos para los checks
# - CAP_DAC_READ_SEARCH: leer ficheros protegidos como /etc/shadow para user_attr checks
# - CAP_FOWNER: modificar permisos de ficheros en remediaciones
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_FOWNER CAP_NET_ADMIN
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_FOWNER CAP_NET_ADMIN

# Protección del kernel
ProtectKernelTunables=no   # Necesario para sysctl_set (escribir /proc/sys vía sysctl -w)
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes

# No necesita memoria ejecutable
MemoryDenyWriteExecute=yes

# Limitar recursos
LimitNOFILE=4096
LimitNPROC=64

[Install]
WantedBy=multi-user.target
