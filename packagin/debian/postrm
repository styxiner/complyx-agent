#!/bin/bash
# postrm — se ejecuta después de eliminar el paquete
set -e

case "$1" in
    purge)
        # purge elimina también los datos: certificados, BD local, configuración
        rm -rf /var/lib/complyx
        rm -rf /etc/complyx

        # Eliminar usuario y grupo del sistema
        if getent passwd complyx > /dev/null 2>&1; then
            userdel complyx || true
        fi
        if getent group complyx > /dev/null 2>&1; then
            groupdel complyx || true
        fi

        systemctl daemon-reload || true
        ;;

    remove)
        # remove no elimina los datos (certificados, BD local)
        # El admin puede reinstalar el agente y recuperar el estado
        systemctl daemon-reload || true
        ;;

    upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;
    *)
        echo "postrm llamado con argumento desconocido: $1" >&2
        exit 1
        ;;
esac

exit 0

